<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.javaorm</groupId>
        <artifactId>java-orm</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>java-orm-bridge</artifactId>
    <packaging>pom</packaging>
    <name>java-orm-bridge</name>
    <description>Bridge adapter parent for third-party ORMs (MyBatis, MyBatis-Plus, JPA, EasyQuery)</description>

    <modules>
        <module>bridge-mybatis</module>
        <module>bridge-mybatis-plus</module>
        <module>bridge-jpa</module>
        <module>bridge-easyquery</module>
    </modules>

    <properties>
        <mybatis.version>3.5.15</mybatis.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <easy-query.version>2.2.0</easy-query.version>
        <jpa.version>2.2</jpa.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.javaorm</groupId>
                <artifactId>java-orm-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.javaorm</groupId>
                <artifactId>bridge-mybatis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-extension</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.easy-query</groupId>
                <artifactId>sql-core</artifactId>
                <version>${easy-query.version}</version>
            </dependency>
            <dependency>
                <groupId>javax.persistence</groupId>
                <artifactId>javax.persistence-api</artifactId>
                <version>${jpa.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
